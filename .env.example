# Copy this file to .env.local and fill in what you need.
# .env.local is git-ignored. Never commit real values.

# Port for the office (default 5180)
# OFFICE_PORT=5180

# Password for the page. Optional on localhost, REQUIRED for `npm run dev:lan`
# (opening the office to phones on your Wi-Fi).
# OFFICE_PASSWORD=

# Token agents must send when reporting status. Optional on localhost.
# OFFICE_TOKEN=

# Where scripts/status.mjs and the MCP server send updates (default http://localhost:<OFFICE_PORT>)
# OFFICE_URL=http://localhost:5180

# MCP server only: the agent this AI always is, so report_status can leave "agent" out.
# Usually set per app in its MCP settings rather than here.
# OFFICE_AGENT=

# Usage board: read real token usage from Claude Code's local logs
# (~/.claude/projects). Set to 0 to turn off.
# USAGE_FROM_CLAUDE_CODE=1
# Week resets on this day (0=Sun, 1=Mon ... 6=Sat) at this local hour.
# USAGE_RESET_DAY=1
# USAGE_RESET_HOUR=0
# Only set this if you know your weekly limit in tokens; otherwise the board
# shows usage and reset time, and does not guess what is left.
# USAGE_WEEKLY_LIMIT_TOKENS=

# Log every hook-driven status update to %TEMP%/agent-office-hooks.log
# OFFICE_HOOK_DEBUG=1
